{
  "name": "langchainjs-handbook",
  "version": "1.0.0",
  "description": "LangChain.js 中文手册 + 浏览器内交互式训练场（Chinese handbook & in-browser playground for LangChain.js）",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint docs/.vitepress scripts examples --deny-warnings",
    "format": "prettier --write \"docs/.vitepress/**/*.{ts,vue,css}\" \"scripts/**/*.ts\" \"examples/**/*.ts\" \"*.{json,yml,yaml}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"docs/.vitepress/**/*.{ts,vue,css}\" \"scripts/**/*.ts\" \"examples/**/*.ts\" \"*.{json,yml,yaml}\" \".github/**/*.{yml,yaml}\"",
    "check:links": "tsx scripts/check-local-links.ts",
    "check:snippets": "tsx scripts/verify-doc-snippets.ts",
    "check:bundle": "tsx scripts/check-bundle-size.ts",
    "optimize:images": "tsx scripts/optimize-images.ts",
    "example:first-call": "tsx examples/real-model/first-call.ts",
    "example:agent-memory": "tsx examples/real-model/agent-memory.ts",
    "example:mcp": "tsx examples/basic-mcp-server.ts",
    "example:mcp:client": "tsx examples/mcp-client.ts",
    "example:mcp-rag": "tsx examples/mcp-rag-server/index.ts",
    "test:examples": "tsx scripts/verify-examples.ts",
    "test:mcp": "tsx scripts/verify-mcp-http.ts",
    "test:samples": "npm run test:examples && npm run test:mcp",
    "test:exercises": "tsx scripts/verify-exercises.ts",
    "test:demos": "tsx scripts/verify-demos.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:links && npm run check:snippets && npm run test:samples && npm run test:exercises && npm run test:demos",
    "ci": "npm run check && npm run build && npm run check:bundle"
  },
  "keywords": [
    "langchain",
    "langchainjs",
    "ai",
    "llm",
    "handbook",
    "playground",
    "typescript",
    "vitepress"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vue": "^3.5.41"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.9.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@langchain/classic": "^1.0.48",
    "@langchain/core": "^1.2.8",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/openai": "^1.5.8",
    "@langchain/textsplitters": "^1.0.1",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^17.4.2",
    "langchain": "^1.5.12",
    "markdown-it": "^14.1.0",
    "mathjs": "^15.2.0",
    "sucrase": "^3.35.0",
    "zod": "^4.6.5"
  }
}
